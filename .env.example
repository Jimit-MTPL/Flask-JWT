# Flask application secret key (for session management, CSRF, etc.)
FLASK_SECRET_KEY="your-flask-secret-key-here"

# JWT Secret Key (for signing JWT tokens)
JWT_SECRET_KEY="your-super-secret-jwt-key-here"

# Database URL (e.g., for PostgreSQL, MySQL, or SQLite)
# Examples:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase"
# DATABASE_URL="mysql://user:password@localhost/mydatabase"
# DATABASE_URL="sqlite:///./instance/app.db"
DATABASE_URL="postgresql://user:password@host:port/database"

# Google OAuth Credentials
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# Frontend URL (where to redirect after OAuth login)
# This is the path to your frontend client's main page.
# If your frontend is served on a different domain/port, use the full URL.
# Example: FRONTEND_URL="http://localhost:3000"
FRONTEND_URL="/frontend/web-client/index.html"

# Allow OAuthlib to work with HTTP for local development/testing of Google OAuth.
# IMPORTANT: This MUST NOT be set to "1" in a production environment.
# Production OAuth 2.0 requires HTTPS for all communications.
OAUTHLIB_INSECURE_TRANSPORT="1"
